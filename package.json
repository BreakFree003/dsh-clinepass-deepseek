{
  "name": "dsh-clinepass",
  "version": "0.12.7",
  "description": "Cline Pass for DeepSeek Harness: an OpenAI-compatible provider route that provisions itself on Settings → Models, reports the real upstream provider it sees in the gateway's chat responses (composer pill + status file), draws the Cline Pass usage card, and keeps the route's transport prefix out of the model-facing prompt. It never rewrites a request.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "install.mjs",
    "uninstall.mjs",
    "smoke-test.mjs",
    "test-fetch.mjs",
    "test-settings.mjs",
    "test-usage.mjs",
    "test-install.mjs",
    "patch.example.yml",
    "test-package.mjs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "RELEASING.md",
    "patch-file.mjs",
    "patch-inhistory.mjs",
    "patch-gateway-routing.mjs"
  ],
  "scripts": {
    "test": "node test-package.mjs && node test-fetch.mjs && node test-settings.mjs && node test-usage.mjs && node test-install.mjs",
    "test:installed": "node test-fetch.mjs && node test-settings.mjs && node test-usage.mjs",
    "test:package": "node test-package.mjs",
    "test:fetch": "node test-fetch.mjs",
    "test:settings": "node test-settings.mjs",
    "test:usage": "node test-usage.mjs",
    "test:install": "node test-install.mjs",
    "smoke": "node smoke-test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "cline",
    "cline-pass",
    "provider",
    "provider-observer",
    "usage",
    "plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BreakFree003/dsh-clinepass-deepseekv4.1.git"
  },
  "homepage": "https://github.com/BreakFree003/dsh-clinepass-deepseekv4.1#readme",
  "bugs": {
    "url": "https://github.com/BreakFree003/dsh-clinepass-deepseekv4.1/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
